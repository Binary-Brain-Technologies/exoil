# ---------------------------------------------------------------------------
# EXOIL website — environment variables (copy to .env.local for development).
# Never commit real values. Configure Production and Preview separately in Vercel.
# ---------------------------------------------------------------------------

# Canonical site URL (no trailing slash). Used for canonicals, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://exoil.pl

# Content mode (read at BUILD time — static pages are prerendered):
#   production (default) — only verified facts are rendered
#   review               — unverified facts are shown with a "Do weryfikacji" marker; the whole site is noindex
CONTENT_MODE=production

# Indexing is decided at BUILD time for static pages. Vercel production builds are indexable automatically.
# Hosting elsewhere: set SITE_INDEXABLE=true for the production build. Set "false" to force noindex.
# On Vercel, non-production deployments are noindex automatically (VERCEL_ENV !== "production").
# SITE_INDEXABLE=false

# --- Form e-mail delivery (Resend, https://resend.com) ----------------------
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (SPF/DKIM records added by the client's DNS admin).
FORMS_FROM_EMAIL="EXOIL — formularz <formularze@exoil.pl>"
# Optional: override the API base (tests / mock server only).
# RESEND_API_BASE=https://api.resend.com

# Recipients (comma-separated lists allowed). Use role addresses, never personal ones.
ORDER_TO_EMAIL=
CONTACT_TO_EMAIL=
CONTACT_TO_EMAIL_SALES=
CONTACT_TO_EMAIL_LOGISTICS=
CONTACT_TO_EMAIL_ACCOUNTING=
CONTACT_TO_EMAIL_STATIONS=
CAREERS_TO_EMAIL=

# --- Recruitment ---------------------------------------------------------------
# PDF CV upload on /kariera/ (attached to the HR e-mail, never stored). Off until the
# client approves the recruitment privacy notice and retention rules.
RECRUITMENT_UPLOADS_ENABLED=false

# --- Rate limiting -----------------------------------------------------------------
# Salt for hashing visitor IPs in the limiter (any random string).
RATE_LIMIT_SALT=
# Optional shared limiter across serverless instances (Upstash Redis REST).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
